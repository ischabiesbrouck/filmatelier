{
  "name": "Filmatelier — van idee tot première",
  "short_name": "Filmatelier",
  "description": "Bedenk, schrijf en produceer je speelfilm: ideeën, structuur, scenario, breakdown, draaischema, callsheets, budget, post en festivals.",
  "lang": "nl",
  "id": "./",
  "start_url": "./#/overzicht",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#ececec",
  "theme_color": "#ececec",
  "categories": ["productivity", "entertainment", "photo"],
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Scenario", "url": "./#/scenario", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Draaischema", "url": "./#/stripboard", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Callsheets", "url": "./#/callsheet", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
